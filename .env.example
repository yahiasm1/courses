# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this site (used for SlickPay return + webhook URLs)
NEXT_PUBLIC_SITE_URL=https://coursesdz.com
# For local development use: NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SlickPay — https://developers.slick-pay.com/authentication
# Your PUBLIC_KEY from the SlickPay dashboard. Leave empty with the sandbox URL to use
# SlickPay's public test key. Test keys only work on devapi, live keys only on prodapi.
SLICKPAY_API_KEY=
# Use https://prodapi.slick-pay.com/api/v2 when you go live
SLICKPAY_BASE_URL=https://devapi.slick-pay.com/api/v2
# Optional: UUID of the SlickPay account that receives payments (default account if empty)
SLICKPAY_ACCOUNT_UUID=
# Random string, sent with each invoice and checked on incoming webhooks
SLICKPAY_WEBHOOK_SECRET=change-me

# Purchase emails via Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend (coursesdz.com)
EMAIL_FROM=Courses DZ <no-reply@coursesdz.com>
# Where new-sale notifications go (comma-separated). Also used as reply-to for receipts.
NOTIFY_EMAIL=
# Optional: a different reply-to address for customer emails
EMAIL_REPLY_TO=

# Only for scripts/add-course.mjs (announcing new courses on Telegram); not needed on Vercel.
# Bot from @BotFather, added as an admin of the channel. Private channels use the numeric id (-100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
