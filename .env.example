# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this site (used for SlickPay return + webhook URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SlickPay — https://developers.slick-pay.com/authentication
SLICKPAY_API_KEY=your-slickpay-api-key
# Use https://prodapi.slick-pay.com/api/v2 when you go live
SLICKPAY_BASE_URL=https://devapi.slick-pay.com/api/v2
# Optional: UUID of the SlickPay account that receives payments (default account if empty)
SLICKPAY_ACCOUNT_UUID=
# Random string, sent with each invoice and checked on incoming webhooks
SLICKPAY_WEBHOOK_SECRET=change-me
